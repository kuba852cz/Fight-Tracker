<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="mainAnchorPane" prefHeight="576.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fighttracker.Controlers.WinnerAnnoucmentController">
   <children>
      <HBox alignment="CENTER" prefHeight="40.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Button alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" prefHeight="26.0" prefWidth="90.0" text="Back" onAction="#onBackButtonClick"/>
         </children></HBox>
      <Label prefHeight="40.0" prefWidth="314.0" text="FIGHT ANNOUCMENT!" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <Separator prefWidth="200.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0" />
      <VBox prefHeight="466.0" prefWidth="256.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="60.0">
         <children>
            <Label fx:id="labelWinnerLeft" alignment="CENTER" prefHeight="18.0" prefWidth="473.0" text="Label">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <ImageView fx:id="imageLeft" fitHeight="375.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="labelNameLeft" text="Label">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="labelNicknameLeft" text="Label">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <VBox prefHeight="466.0" prefWidth="224.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="400.0" AnchorPane.rightAnchor="400.0" AnchorPane.topAnchor="60.0">
         <children>
            <Region prefHeight="200.0" prefWidth="200.0" />
            <Label alignment="CENTER" prefHeight="18.0" prefWidth="262.0" text="VS">
               <font>
                  <Font size="30.0" />
               </font>
            </Label>
            <Label fx:id="labelTypeOfFinish" alignment="CENTER" prefHeight="18.0" prefWidth="396.0" text="Label">
               <font>
                  <Font size="24.0" />
               </font>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER" prefHeight="0.0" prefWidth="224.0">
               <children>
                  <Label fx:id="labelRound" text="Label">
                     <font>
                        <Font size="24.0" />
                     </font></Label>
                  <Separator orientation="VERTICAL" prefHeight="200.0" />
                  <Label fx:id="labelTime" text="Label">
                     <font>
                        <Font size="24.0" />
                     </font></Label>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox prefHeight="466.0" prefWidth="256.0" AnchorPane.bottomAnchor="50.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">
         <children>
            <Label fx:id="labelWinnerRight" alignment="CENTER" prefHeight="18.0" prefWidth="473.0" text="Label">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <ImageView fx:id="imageRight" fitHeight="375.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="labelNameRight" text="Label">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="labelNicknameRight" text="Label">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
