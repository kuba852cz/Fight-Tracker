<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="mainVBox" alignment="TOP_CENTER" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fighttracker.Controlers.TitleScreenController">
   <children>
      <ImageView fx:id="logoImageView" pickOnBounds="true" preserveRatio="true">
         <VBox.margin>
            <Insets bottom="20.0" />
         </VBox.margin></ImageView>
      <Button mnemonicParsing="false" onAction="#onRankingButtonClick" minHeight="40.0" prefWidth="300.0" text="Ranking" />
      <Button mnemonicParsing="false" onAction="#onSimulationButtonClick" minHeight="40.0" prefWidth="300.0" text="Simulate" />
      <Button mnemonicParsing="false" onAction="#onSettingsButtonClick" minHeight="40.0" prefWidth="300.0" text="Settings" />
      <Button mnemonicParsing="false" onAction="#onExitButtonClick" minHeight="40.0" prefWidth="300.0" style="-fx-background-color: RED;" text="Exit" textFill="WHITE">
         <VBox.margin>
            <Insets bottom="20.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
